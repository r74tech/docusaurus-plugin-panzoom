{
  "name": "docs",
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint": "oxlint src --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt src docs docusaurus.config.ts",
    "format:check": "oxfmt --check src docs docusaurus.config.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@docusaurus/theme-mermaid": "3.9.2",
    "@mdx-js/react": "^3.1.1",
    "@r74tech/docusaurus-plugin-panzoom": "file:..",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "lint-staged": "^15.5.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "~5.6.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "lint-staged": {
    "{src,docs}/**/*.{js,jsx,ts,tsx,css,json,md,mdx}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
